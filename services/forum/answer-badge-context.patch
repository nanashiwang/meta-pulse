diff --git a/internal/schema/metar_badge_context_test.go b/internal/schema/metar_badge_context_test.go
--- a/internal/schema/metar_badge_context_test.go
+++ b/internal/schema/metar_badge_context_test.go
@@ -0,0 +1,33 @@
+package schema
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestMetarBadgeContextCache(t *testing.T) {
+	c := NewRedDotBadgeAwardCache()
+	c.AddBadgeAward(&RedDotBadgeAward{NotificationID: "10", BadgeID: "1", ContentTitle: "<script>example</script>", Description: "score >= 10"})
+	c.AddBadgeAward(&RedDotBadgeAward{NotificationID: "11", BadgeID: "1", ContentTitle: "Another post"})
+	copy := NewRedDotBadgeAwardCache()
+	copy.FromJSON(c.ToJSON())
+	if len(copy.BadgeAwardList) != 2 || copy.BadgeAwardList["10"].ContentTitle != "<script>example</script>" {
+		t.Fatal("content must remain separate per notification")
+	}
+	copy.RemoveBadgeAward("10")
+	if len(copy.BadgeAwardList) != 1 || copy.BadgeAwardList["11"].ContentTitle != "Another post" {
+		t.Fatal("reading one award must not remove another")
+	}
+	if strings.Contains(c.ToJSON(), "<script>") {
+		t.Fatal("JSON must escape markup")
+	}
+}
+
+func TestMetarLegacyBadgeContextCache(t *testing.T) {
+	c := NewRedDotBadgeAwardCache()
+	c.FromJSON(`{"badge_award_list":{"10":{"notification_id":"10","badge_id":"1"}}}`)
+	award := c.GetBadgeAward()
+	if award == nil || award.BadgeID != "1" || award.ContentTitle != "" || award.Description != "" {
+		t.Fatal("legacy alerts must remain readable without invented context")
+	}
+}
