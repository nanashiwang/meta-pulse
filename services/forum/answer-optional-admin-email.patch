+package schema
+
+import (
+	"context"
+	"testing"
+)
+
+func TestMetarParseAdminUserWithoutEmail(t *testing.T) {
+	req := &AddUsersReq{UsersStr: "Guest One, ,Password1\nGuest Two, ,Password2"}
+	if _, err := req.ParseUsers(context.Background()); err != nil {
+		t.Fatalf("parse users without email: %v", err)
+	}
+	if len(req.Users) != 2 {
+		t.Fatalf("parsed %d users, want 2", len(req.Users))
+	}
+	for _, user := range req.Users {
+		if user.Email != "" {
+			t.Fatalf("email = %q, want empty", user.Email)
+		}
+	}
+}
