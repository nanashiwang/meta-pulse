@@ -0,0 +1,24 @@
+package user_admin
+
+import (
+	"context"
+	"testing"
+
+	"github.com/apache/answer/internal/schema"
+)
+
+func TestMetarAdminEmailIsOptionalAndUniqueWhenPresent(t *testing.T) {
+	service := &UserAdminService{}
+	withoutEmail := []*schema.AddUserReq{
+		{DisplayName: "Guest One", Password: "Password1"},
+		{DisplayName: "Guest Two", Password: "Password2"},
+	}
+	if got := service.checkUserDuplicateInner(context.Background(), withoutEmail); got != nil {
+		t.Fatalf("blank emails rejected: %+v", got)
+	}
+
+	invalidEmail := []*schema.AddUserReq{{DisplayName: "Guest", Email: "not-an-email", Password: "Password1"}}
+	if got := service.checkUserDuplicateInner(context.Background(), invalidEmail); got == nil {
+		t.Fatal("invalid non-empty email accepted")
+	}
+}
