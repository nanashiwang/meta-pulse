+
+// METAR: the admin list offers 10/20/50/100 rows per page; larger requests are
+// clamped so a crafted page_size cannot load the whole user table at once.
+const metarAdminUserMaxPageSize = 100
+
+func metarAdminUserPageSize(size int) int {
+	if size > metarAdminUserMaxPageSize {
+		return metarAdminUserMaxPageSize
+	}
+	return size
+}
