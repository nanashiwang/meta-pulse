@@ -0,0 +1,11 @@
+package user_admin
+
+import "testing"
+
+func TestMetarAdminUserPageSizeClamp(t *testing.T) {
+	for in, want := range map[int]int{0: 0, 10: 10, 50: 50, 100: 100, 101: 100, 100000: 100} {
+		if got := metarAdminUserPageSize(in); got != want {
+			t.Fatalf("metarAdminUserPageSize(%d) = %d, want %d", in, got, want)
+		}
+	}
+}
