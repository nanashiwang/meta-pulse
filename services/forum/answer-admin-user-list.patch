+// Admin-only, explicit full-result sorting. No partial page is a global rank.
+export const sortKeys = [
+  'user_id',
+  'name',
+  'email',
+  'reputation',
+  'posts',
+  'tickets_remaining',
+  'tickets_total',
+  'tickets_spent',
+  'reward_quota',
+  'reward_experience',
+  'post_count',
+  'post_likes',
+  'comments',
+  'likes',
+  'shares',
+  'api_account',
+  'login_methods',
+  'created_at',
+  'last_login',
+  'role',
+  'status',
+];
+const numericKeys = new Set(
+  sortKeys.filter(
+    (key) => !['name', 'email', 'login_methods', 'status'].includes(key),
+  ),
+);
+export function sortValue(user, bindings, key) {
+  const info = bindings?.[String(user.user_id)];
+  if (key.startsWith('tickets_')) return info?.tickets?.[key.slice(8)];
+  if (key.startsWith('reward_')) return info?.tickets?.[key];
+  if (['post_likes', 'comments', 'likes', 'shares'].includes(key))
+    return info?.statistics?.[key];
+  if (key === 'post_count')
+    return info?.statistics?.posts ?? user.question_count;
+  if (key === 'api_account') return info?.api_user_id;
+  if (key === 'login_methods')
+    return info
+      ? [...(info.providers || []), ...(info.api_user_id ? ['API'] : [])]
+          .sort()
+          .join(',') || 'local'
+      : null;
+  const fields = {
+    name: 'display_name',
+    email: 'e_mail',
+    reputation: 'rank',
+    posts: 'question_count',
+    last_login: 'last_login_date',
+    role: 'role_id',
+  };
+  return user[fields[key] || key];
+}
+export function sortUsers(users, bindings, key, direction) {
+  const compare = (a, b, numeric) => {
+    if (numeric) {
+      const x = BigInt(a);
+      const y = BigInt(b);
+      return x < y ? -1 : x > y ? 1 : 0;
+    }
+    return String(a).localeCompare(String(b), 'zh-CN');
+  };
+  const valid = (value) =>
+    value !== undefined &&
+    value !== null &&
+    value !== '' &&
+    (!numericKeys.has(key) || /^-?\d+$/.test(String(value)));
+  return [...users].sort((a, b) => {
+    const x = sortValue(a, bindings, key);
+    const y = sortValue(b, bindings, key);
+    if (valid(x) !== valid(y)) return valid(x) ? -1 : 1;
+    const order = valid(x) ? compare(x, y, numericKeys.has(key)) : 0;
+    return (
+      (direction === 'asc' ? order : -order) ||
+      compare(a.user_id, b.user_id, true)
+    );
+  });
+}
+export function quotaText(amount, unit) {
+  if (!/^\d+$/.test(String(amount))) return '—';
+  if (!/^\d+$/.test(String(unit)) || BigInt(unit) === BigInt(0))
+    return `${amount} quota`;
+  const n = BigInt(amount);
+  const d = BigInt(unit);
+  let rest = n % d;
+  let decimals = '';
+  for (let i = 0; i < 6 && rest > BigInt(0); i += 1) {
+    rest *= BigInt(10);
+    decimals += String(rest / d);
+    rest %= d;
+  }
+  return `${n / d}${decimals ? `.${decimals}` : ''} ⚡`;
+}
+export async function loadAllUsers(fetchPage, fetchBindings, signal) {
+  const users = [];
+  const bindings = {};
+  const seen = new Set();
+  let expected;
+  for (let page = 1; ; page += 1) {
+    signal.throwIfAborted();
+    // Sequential batches bound server load and detect changes before continuing.
+    // eslint-disable-next-line no-await-in-loop
+    const result = await fetchPage(page, signal);
+    signal.throwIfAborted();
+    if (
+      !Array.isArray(result?.list) ||
+      !Number.isSafeInteger(Number(result.count)) ||
+      Number(result.count) < 0
+    )
+      throw Error('invalid users');
+    if (expected === undefined) expected = Number(result.count);
+    if (expected !== Number(result.count))
+      throw Error('users changed; refresh');
+    if (!result.list.length && users.length < expected)
+      throw Error('incomplete users');
+    result.list.forEach((user) => {
+      const id = String(user.user_id);
+      if (!/^\d+$/.test(id) || seen.has(id))
+        throw Error('users changed; refresh');
+      seen.add(id);
+      users.push(user);
+    });
+    if (result.list.length)
+      Object.assign(
+        bindings,
+        // eslint-disable-next-line no-await-in-loop
+        await fetchBindings(
+          result.list.map((user) => String(user.user_id)),
+          signal,
+        ),
+      );
+    signal.throwIfAborted();
+    if (users.length === expected)
+      return { list: users, count: expected, bindings };
+    if (users.length > expected) throw Error('users changed; refresh');
+  }
+}
