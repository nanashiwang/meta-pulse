# Meta Pulse Community / Apache Answer

# Answer 自有数据库，与 Pulse/new-api 隔离。
FORUM_DB_PASSWORD=replace-me
FORUM_DB_ROOT_PASSWORD=replace-me

# 仅注入 forum 容器，用于安装/检查一对一不可变绑定约束。
# 不得注入 Pulse API/Worker。
FORUM_BINDING_GUARD_DSN=forum:replace-me@tcp(forum-mysql:3306)/meta_pulse_forum?charset=utf8mb4&parseTime=True&loc=Local

# meta-pulse-worker 的 Answer 内容只读账号；不得拥有写权限。
FORUM_DB_READONLY_DSN=readonly_user:readonly_password@tcp(forum-mysql:3306)/meta_pulse_forum?charset=utf8mb4&parseTime=True&loc=Local

# 公网边界：
#   https://metar.uk/       Answer（本地注册/登录）
#   https://metar.uk/blog/  VitePress
#   new-api fixed callback:
#   https://metar.uk/api/user-center/login/callback
# 不发布 forum 容器端口，使用 deploy/nginx。

# 插件配置在 Answer 后台录入：
#   newapi_base_url          https://现有-new-api-域名
#   pulse_base_url           http://pulse-api:8088
#   sso_hmac_secret          与 new-api PULSE_FORUM_SSO_SECRET 一致
#   sso_hmac_secret_previous 仅轮换窗口使用
#   pulse_hmac_secret        与 Pulse PULSE_FORUM_HMAC_SECRET 一致（不得复用结算密钥）
#   nonce_redis_url          redis://redis:6379/2
#   level_badge_enabled      true
#
# Answer 必须保持 EnabledOriginalUserSystem=true；绑定可选且一对一。
