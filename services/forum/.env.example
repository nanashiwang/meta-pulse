# Meta Pulse Forum (Apache Answer)

# Forum database — separate logical DB with its own account
FORUM_DB_PASSWORD=replace-me
FORUM_DB_ROOT_PASSWORD=replace-me

# Read-only account used by meta-pulse-worker for Content Candidate Ingest.
# Pulse must never hold write access to the forum database.
FORUM_DB_READONLY_DSN=readonly_user:readonly_password@tcp(forum-mysql:3306)/meta_pulse_forum?charset=utf8mb4&parseTime=True&loc=Local

# Public deployment boundary (reference):
#   Answer site URL             https://forum.yourdomain.com
#   new-api fixed SSO callback  https://forum.yourdomain.com/api/user-center/login/callback
#   Never publish the forum container port directly; use deploy/nginx.

# Plugin configuration is entered in the Answer admin panel, not here.
# Listed for reference only:
#   newapi_base_url      https://yourdomain.com
#   pulse_base_url       http://pulse-api:8088
#   sso_hmac_secret      must match new-api PULSE_FORUM_SSO_SECRET
#   pulse_hmac_secret    must match Pulse PULSE_SERVICE_HMAC_SECRET
#   nonce_redis_url      redis://redis:6379/2 (shared by every Answer instance)
#   level_badge_enabled  true
