--- /dev/null
+++ b/ui/src/pages/Admin/Privileges/index.scss
@@ -0,0 +1,50 @@
+/* METAR: show the reputation thresholds as a dense grid instead of one long column. */
+.metar-privileges form {
+  display: grid;
+  grid-template-columns: repeat(auto-fill, minmax(min(280px, 100%), 1fr));
+  gap: 8px 12px;
+}
+
+.metar-privileges .metar-privilege-level {
+  grid-column: 1 / -1;
+  max-width: 420px;
+  margin-bottom: 8px;
+}
+
+.metar-privileges .metar-privilege-field {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 4px 10px;
+  margin: 0;
+  padding: 6px 8px 6px 12px;
+  border: 1px solid var(--bs-border-color);
+  border-radius: 6px;
+}
+
+.metar-privileges .metar-privilege-field .form-label {
+  flex: 1 1 0;
+  min-width: 0;
+  margin: 0;
+  font-size: 0.875rem;
+  line-height: 1.3;
+}
+
+.metar-privileges .metar-privilege-field .form-control {
+  flex: none;
+  width: 88px;
+  padding: 2px 8px;
+  font-size: 0.875rem;
+  text-align: right;
+}
+
+.metar-privileges .metar-privilege-field .invalid-feedback {
+  flex-basis: 100%;
+  margin-top: 0;
+}
+
+.metar-privileges form > .btn {
+  grid-column: 1 / -1;
+  justify-self: start;
+  margin-top: 8px;
+}
