+ * Unless required by applicable law or agreed to in writing,
+ * software distributed under the License is distributed on an
+ * "AS IS" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY
+ * KIND, either express or implied.  See the License for the
+ * specific language governing permissions and limitations
+ * under the License.
+ */
+
+package migrations
+
+import (
+	"context"
+	"testing"
+
+	"github.com/apache/answer/internal/base/data"
+	"github.com/apache/answer/internal/entity"
+	commentrepo "github.com/apache/answer/internal/repo/comment"
+)
+
+func TestMetarAIContentLegacyRowsAndCommentEdits(t *testing.T) {
+	ctx := context.Background()
+	db, err := data.NewDB(false, &data.Database{Driver: "sqlite", Connection: ":memory:"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	db.SetMaxOpenConns(1)
+	if err = addAIContentDisclosure(ctx, db); err != nil {
+		t.Fatal(err)
+	}
+	for _, table := range []string{"question", "answer", "comment"} {
+		if _, err = db.Exec("ALTER TABLE " + table + " DROP COLUMN contains_ai_generated"); err != nil {
+			t.Fatal(err)
+		}
+		if _, err = db.Exec("INSERT INTO "+table+" (id, original_text, parsed_text) VALUES (1, ?, ?)", "legacy body", "<p>legacy body</p>"); err != nil {
+			t.Fatal(err)
+		}
+	}
+	for i := 0; i < 2; i++ {
+		if err = addAIContentDisclosure(ctx, db); err != nil {
+			t.Fatal(err)
+		}
+	}
+	for _, table := range []string{"question", "answer", "comment"} {
+		var row struct {
+			ContainsAIGenerated bool `xorm:"'contains_ai_generated'"`
+			OriginalText        string
+		}
+		found, err := db.Table(table).Where("id = ?", 1).Get(&row)
+		if err != nil || !found || row.ContainsAIGenerated || row.OriginalText != "legacy body" {
+			t.Fatalf("%s old row: %+v, found %v, error %v", table, row, found, err)
+		}
+	}
+	repo := commentrepo.NewCommentRepo(&data.Data{DB: db}, nil)
+	yes, no := true, false
+	for _, step := range []struct {
+		flag *bool
+		want bool
+	}{{&yes, true}, {nil, true}, {&no, false}} {
+		if err = repo.UpdateCommentContent(ctx, "1", "edited comment", "<p>edited comment</p>", step.flag); err != nil {
+			t.Fatal(err)
+		}
+		var saved entity.Comment
+		found, err := db.ID(1).Get(&saved)
+		if err != nil || !found || saved.ContainsAIGenerated != step.want || saved.OriginalText != "edited comment" {
+			t.Fatalf("comment: %+v, found %v, error %v", saved, found, err)
+		}
+	}
+}
