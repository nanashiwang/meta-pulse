+ * Unless required by applicable law or agreed to in writing,
+ * software distributed under the License is distributed on an
+ * "AS IS" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY
+ * KIND, either express or implied.  See the License for the
+ * specific language governing permissions and limitations
+ * under the License.
+ */
+
+import { useId } from 'react';
+import { useTranslation } from 'react-i18next';
+
+// Keep copy with the component so warm language caches on upgraded sites
+// display the disclosure in the current language without being invalidated.
+const zh = {
+  declaration: '本文包含 AI 生成内容',
+  answerDeclaration: '这条回答包含 AI 生成内容',
+  hint: '实质内容由 AI 起草、改写或生成时，请勾选。仅查错字、调整格式或轻度润色不必勾选。发布前请核实事实、引用和代码。',
+  badge: '含 AI 生成内容',
+  badgeHint: '作者自行声明，非平台检测。',
+};
+const en = {
+  declaration: 'This content includes AI-generated material',
+  answerDeclaration: 'This answer includes AI-generated material',
+  hint: 'Check this if AI drafted, rewrote, or generated substantive content. Minor proofreading, formatting, or polishing does not require disclosure. Verify facts, citations, and code before posting.',
+  badge: 'Includes AI-generated content',
+  badgeHint: 'Self-reported by the author, not detected by the platform.',
+};
+function useCopy() {
+  const { i18n } = useTranslation();
+  return /^zh(?:[_-]|$)/i.test(i18n.language) ? zh : en;
+}
+
+interface DisclosureProps {
+  checked: boolean;
+  onChange: (checked: boolean) => void;
+  answer?: boolean;
+}
+
+export const AIContentDisclosure = ({
+  checked,
+  onChange,
+  answer,
+}: DisclosureProps) => {
+  const copy = useCopy();
+  const id = useId();
+  return (
+    <div className="form-check my-2 small">
+      <input
+        id={id}
+        type="checkbox"
+        className="form-check-input"
+        checked={checked}
+        onChange={(event) => onChange(event.target.checked)}
+        aria-describedby={`${id}-hint`}
+      />
+      <label className="form-check-label" htmlFor={id}>
+        {answer ? copy.answerDeclaration : copy.declaration}
+      </label>
+      <div id={`${id}-hint`} className="form-text">
+        {copy.hint}
+      </div>
+    </div>
+  );
+};
+
+export const AIContentBadge = ({ declared }: { declared?: boolean }) => {
+  const copy = useCopy();
+  return declared === true ? (
+    <span
+      className="badge bg-light text-secondary border ms-2 align-middle fw-normal"
+      title={copy.badgeHint}>
+      {copy.badge}
+    </span>
+  ) : null;
+};
