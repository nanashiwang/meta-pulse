@@ -21,6 +21,9 @@ package converter
 
 import (
 	"regexp"
+	"strings"
+
+	"golang.org/x/net/html"
 
 	"github.com/segmentfault/pacman/utils"
 )
@@ -41,3 +44,61 @@ func GetMentionUsernameList(text string) []string {
 	}
 	return usernames
 }
+
+// PublishedMentionUsernames derives recipients from the rendered comment, not
+// from a client-supplied recipient list or mentions inside code.
+func PublishedMentionUsernames(rendered string) []string {
+	const max = 5
+	token := html.NewTokenizer(strings.NewReader(rendered))
+	var names []string
+	seen := map[string]bool{}
+	var candidate, text string
+	ignored := 0
+	for token.Next() != html.ErrorToken {
+		tk := token.Token()
+		switch tk.Type {
+		case html.StartTagToken:
+			if tk.Data == "pre" || tk.Data == "code" {
+				ignored++
+				candidate = ""
+			}
+			if tk.Data == "a" && ignored == 0 {
+				candidate, text = "", ""
+				for _, attr := range tk.Attr {
+					if attr.Key == "href" && strings.HasPrefix(attr.Val, "/users/") {
+						candidate = strings.TrimPrefix(attr.Val, "/users/")
+					}
+				}
+				if !mentionUsername.MatchString(candidate) {
+					candidate = ""
+				}
+			}
+		case html.TextToken:
+			if candidate != "" {
+				if len(text)+len(tk.Data) > 33 {
+					candidate = ""
+				} else {
+					text += tk.Data
+				}
+			}
+		case html.EndTagToken:
+			if (tk.Data == "pre" || tk.Data == "code") && ignored > 0 {
+				ignored--
+			}
+			if tk.Data == "a" && candidate != "" {
+				name := strings.ToLower(candidate)
+				if text == "@"+candidate && !seen[name] {
+					names = append(names, name)
+					seen[name] = true
+					if len(names) == max {
+						return names
+					}
+				}
+				candidate = ""
+			}
+		}
+	}
+	return names
+}
+
+var mentionUsername = regexp.MustCompile(`^[A-Za-z0-9_.-]{1,32}$`)
