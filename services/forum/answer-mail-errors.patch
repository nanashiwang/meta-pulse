+)
+
+type mailConfigRepo struct {
+	config.ConfigRepo
+	value string
+	err   error
+}
+
+func (r mailConfigRepo) GetConfigByKey(context.Context, string) (*entity.Config, error) {
+	return &entity.Config{Value: r.value}, r.err
+}
+
+type mailCodeRepo struct {
+	EmailRepo
+	err error
+}
+
+func (r mailCodeRepo) SetCode(context.Context, string, string, string, time.Duration) error {
+	return r.err
+}
+func mailService(ec EmailConfig) *EmailService {
+	raw, _ := json.Marshal(ec)
+	return &EmailService{configService: config.NewConfigService(mailConfigRepo{value: string(raw)})}
+}
+func requireMailFailure(t *testing.T, err error) {
+	t.Helper()
+	var public *pacerrors.Error
+	if !errors.As(err, &public) || public.Code != 503 || public.Reason != "error.email_send_failed" {
+		t.Fatalf("expected sanitized mail failure, got %v", err)
+	}
+}
+func TestMetarMailMissingConfiguration(t *testing.T) {
+	requireMailFailure(t, mailService(EmailConfig{}).Send(context.Background(), "user@example.com", "test", "body"))
+	service := &EmailService{configService: config.NewConfigService(mailConfigRepo{err: errors.New("private database detail")})}
+	requireMailFailure(t, service.Send(context.Background(), "user@example.com", "test", "body"))
+	service = &EmailService{emailRepo: mailCodeRepo{err: errors.New("cache unavailable")}}
+	requireMailFailure(t, service.SendAndSaveCode(context.Background(), "id", "user@example.com", "test", "body", "code", "{}"))
+}
+
+// A local SMTP peer verifies the final DATA response, not merely TCP connect.
+func mailPeer(t *testing.T, reject bool, stall bool) (EmailConfig, <-chan string) {
+	t.Helper()
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = listener.Close() })
+	received := make(chan string, 1)
+	go func() {
+		conn, err := listener.Accept()
+		if err != nil {
+			return
+		}
+		defer conn.Close()
+		_ = conn.SetDeadline(time.Now().Add(3 * time.Second))
+		if stall {
+			_, _ = bufio.NewReader(conn).ReadString('\n')
+			return
+		}
+		fmt.Fprint(conn, "220 local test\r\n")
+		reader := bufio.NewReader(conn)
+		for {
+			line, err := reader.ReadString('\n')
+			if err != nil {
+				return
+			}
+			switch {
+			case strings.HasPrefix(line, "EHLO"), strings.HasPrefix(line, "HELO"):
+				fmt.Fprint(conn, "250 local test\r\n")
+			case strings.HasPrefix(line, "MAIL"), strings.HasPrefix(line, "RCPT"):
+				fmt.Fprint(conn, "250 OK\r\n")
+			case strings.HasPrefix(line, "DATA"):
+				fmt.Fprint(conn, "354 continue\r\n")
+				var body strings.Builder
+				for {
+					part, err := reader.ReadString('\n')
+					if err != nil {
+						return
+					}
+					if part == ".\r\n" {
+						break
+					}
+					body.WriteString(part)
+				}
+				received <- body.String()
+				if reject {
+					fmt.Fprint(conn, "550 rejected private provider detail\r\n")
+				} else {
+					fmt.Fprint(conn, "250 queued\r\n")
+				}
+			default:
+				return
+			}
+		}
+	}()
+	address := listener.Addr().(*net.TCPAddr)
+	return EmailConfig{SMTPHost: "127.0.0.1", SMTPPort: address.Port, FromEmail: "sender@example.com"}, received
+}
+func TestMetarMailSMTPResult(t *testing.T) {
+	for _, reject := range []bool{false, true} {
+		t.Run(fmt.Sprint(reject), func(t *testing.T) {
+			ec, received := mailPeer(t, reject, false)
+			service := mailService(ec)
+			service.emailRepo = mailCodeRepo{}
+			err := service.SendAndSaveCode(context.Background(), "user-id", "user@example.com", "Activation", "activation-link", "code", "{}")
+			if reject {
+				requireMailFailure(t, err)
+			} else if err != nil {
+				t.Fatal(err)
+			}
+			select {
+			case body := <-received:
+				if !strings.Contains(body, "activation-link") {
+					t.Fatal("missing message body")
+				}
+			case <-time.After(time.Second):
+				t.Fatal("no message")
+			}
+		})
+	}
+}
+func TestMetarMailTimeoutAndRequiredTLS(t *testing.T) {
+	ec, _ := mailPeer(t, false, true)
+	message := gomail.NewMessage()
+	message.SetHeader("From", ec.FromEmail)
+	message.SetHeader("To", "user@example.com")
+	message.SetBody("text/plain", "test")
+	start := time.Now()
+	if err := sendSMTP(context.Background(), &ec, message, 50*time.Millisecond); err == nil {
+		t.Fatal("stall succeeded")
+	}
+	if time.Since(start) > time.Second {
+		t.Fatal("deadline not enforced")
+	}
+	ec, _ = mailPeer(t, false, false)
+	ec.Encryption = "TLS"
+	if err := sendSMTP(context.Background(), &ec, message, time.Second); err == nil {
+		t.Fatal("required TLS silently downgraded")
+	}
+}
+func TestMetarMailLoginAuthentication(t *testing.T) {
+	auth := &smtpLoginAuth{username: "user", password: "secret", host: "mail.example.com"}
+	if _, _, err := auth.Start(&smtp.ServerInfo{Name: "mail.example.com"}); err == nil {
+		t.Fatal("sent credentials without TLS")
+	}
+	mechanism, initial, err := auth.Start(&smtp.ServerInfo{Name: "mail.example.com", TLS: true})
+	if err != nil || mechanism != "LOGIN" || string(initial) != "user" {
+		t.Fatal("LOGIN start failed")
+	}
+	password, err := auth.Next([]byte("Password:"), true)
+	if err != nil || string(password) != "secret" {
+		t.Fatal("LOGIN password failed")
+	}
+}
