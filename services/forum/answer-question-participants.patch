diff --git a/internal/repo/answer/participants_test.go b/internal/repo/answer/participants_test.go
--- /dev/null
+++ b/internal/repo/answer/participants_test.go
@@ -0,0 +1,61 @@
+package answer
+
+import (
+	"context"
+	"github.com/apache/answer/internal/base/data"
+	"github.com/apache/answer/internal/entity"
+	"testing"
+	"xorm.io/xorm"
+	"xorm.io/xorm/names"
+)
+
+func TestMetarQuestionParticipants(t *testing.T) {
+	db, err := xorm.NewEngine("sqlite", ":memory:")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	db.SetMaxOpenConns(1)
+	db.SetColumnMapper(names.GonicMapper{})
+	if _, err = db.Exec("CREATE TABLE answer (question_id TEXT, user_id TEXT, status INTEGER, created_at INTEGER)"); err != nil {
+		t.Fatal(err)
+	}
+	// Repeated replies from one user must not crowd out the other participants.
+	for _, row := range []struct {
+		q, u  string
+		s, at int
+	}{
+		{"q1", "a", entity.AnswerStatusAvailable, 100}, {"q1", "a", entity.AnswerStatusAvailable, 99},
+		{"q1", "b", entity.AnswerStatusAvailable, 90}, {"q1", "c", entity.AnswerStatusAvailable, 80},
+		{"q1", "d", entity.AnswerStatusAvailable, 70}, {"q1", "e", entity.AnswerStatusAvailable, 60},
+		{"q1", "f", entity.AnswerStatusAvailable, 50}, {"q1", "hidden", 999, 200},
+		{"q2", "other", entity.AnswerStatusAvailable, 300}, {"private", "secret", entity.AnswerStatusAvailable, 400},
+	} {
+		if _, err = db.Exec("INSERT INTO answer VALUES (?, ?, ?, ?)", row.q, row.u, row.s, row.at); err != nil {
+			t.Fatal(err)
+		}
+	}
+	repo := &answerRepo{data: &data.Data{DB: db}}
+	rows, err := repo.GetQuestionParticipants(context.Background(), []string{"q1", "q2"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(rows) != 6 {
+		t.Fatalf("rows=%+v", rows)
+	}
+	for i, want := range []string{"a", "b", "c", "d", "e", "other"} {
+		if rows[i].UserID != want {
+			t.Fatalf("row %d: got %s want %s", i, rows[i].UserID, want)
+		}
+	}
+	rows, err = repo.GetQuestionParticipants(context.Background(), nil)
+	if err != nil || len(rows) != 0 {
+		t.Fatal(rows, err)
+	}
+	if _, err = db.Exec("DROP TABLE answer"); err != nil {
+		t.Fatal(err)
+	}
+	if _, err = repo.GetQuestionParticipants(context.Background(), []string{"q1"}); err == nil {
+		t.Fatal("query error swallowed")
+	}
+}
