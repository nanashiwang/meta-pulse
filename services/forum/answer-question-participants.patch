+// GetQuestionParticipants returns at most five distinct public answer authors per question.
+// The bounded projection shares the list's user lookup; no answer text is selected.
+func (ar *answerRepo) GetQuestionParticipants(ctx context.Context, questionIDs []string) ([]*entity.Answer, error) {
+	rows := make([]*entity.Answer, 0)
+	if len(questionIDs) == 0 {
+		return rows, nil
+	}
+	args := []interface{}{entity.AnswerStatusAvailable}
+	for _, id := range questionIDs {
+		args = append(args, id)
+	}
+	query := "SELECT question_id, user_id FROM (SELECT question_id, user_id, ROW_NUMBER() OVER (PARTITION BY question_id ORDER BY MAX(created_at) DESC, user_id ASC) AS participant_rank FROM answer WHERE status = ? AND question_id IN (" + strings.TrimSuffix(strings.Repeat("?,", len(questionIDs)), ",") + ") GROUP BY question_id, user_id) participants WHERE participant_rank <= 5 ORDER BY question_id, participant_rank"
+	err := ar.data.DB.Context(ctx).SQL(query, args...).Find(&rows)
+	return rows, err
+}
