+package notification
+
+import (
+	"context"
+	"html"
+	"io"
+	"strings"
+
+	"github.com/apache/answer/internal/base/constant"
+	"github.com/apache/answer/internal/entity"
+	"github.com/apache/answer/internal/schema"
+	xhtml "golang.org/x/net/html"
+)
+
+func commentPreview(text string) string {
+	tokenizer := xhtml.NewTokenizer(strings.NewReader(text))
+	var plain strings.Builder
+	skip := false
+	for {
+		kind := tokenizer.Next()
+		if kind == xhtml.ErrorToken {
+			if tokenizer.Err() == io.EOF {
+				break
+			}
+			return ""
+		}
+		token := tokenizer.Token()
+		switch kind {
+		case xhtml.StartTagToken:
+			if token.Data == "script" || token.Data == "style" {
+				skip = true
+			}
+			if token.Data == "br" || token.Data == "p" {
+				plain.WriteByte(' ')
+			}
+		case xhtml.EndTagToken:
+			if token.Data == "script" || token.Data == "style" {
+				skip = false
+			}
+			if token.Data == "p" {
+				plain.WriteByte(' ')
+			}
+		case xhtml.TextToken:
+			if !skip {
+				plain.WriteString(token.Data)
+			}
+		}
+	}
+	chars := []rune(strings.Join(strings.Fields(plain.String()), " "))
+	if len(chars) > 25 {
+		return string(chars[:25]) + "…"
+	}
+	return string(chars)
+}
+
+// Re-read current public content: never expose deleted, hidden or pending comments.
+func (ns *NotificationService) addInboxPreview(ctx context.Context, item *schema.NotificationContent) {
+	if item.ObjectInfo.ObjectMap != nil {
+		delete(item.ObjectInfo.ObjectMap, "comment_preview")
+		delete(item.ObjectInfo.ObjectMap, "answer_preview")
+	}
+	action := item.NotificationAction
+	if action == constant.NotificationAnswerTheQuestion {
+		ref := item.ObjectInfo
+		if ref.ObjectType != "answer" || ref.ObjectID == "" || ref.ObjectMap["question"] == "" {
+			return
+		}
+		var answer entity.Answer
+		exists, err := ns.data.DB.Context(ctx).Alias("a").Join("INNER", []string{"question", "q"}, "q.id = a.question_id").
+			Where("a.id = ? AND a.question_id = ? AND a.status = ? AND q.status IN (?, ?) AND q.`show` = ?", ref.ObjectID, ref.ObjectMap["question"], entity.AnswerStatusAvailable, entity.QuestionStatusAvailable, entity.QuestionStatusClosed, entity.QuestionShow).
+			Select("a.parsed_text, a.original_text").Get(&answer)
+		if err == nil && exists {
+			text := answer.ParsedText
+			if text == "" {
+				text = html.EscapeString(answer.OriginalText)
+			}
+			ref.ObjectMap["answer_preview"] = commentPreview(text)
+		}
+		return
+	}
+	if action != constant.NotificationCommentQuestion && action != constant.NotificationCommentAnswer && action != constant.NotificationReplyToYou && !(action == constant.NotificationMentionYou && item.ObjectInfo.ObjectType == "comment") {
+		return
+	}
+	id := item.ObjectInfo.ObjectMap["comment"]
+	if id == "" {
+		return
+	}
+	var comment entity.Comment
+	exists, err := ns.data.DB.Context(ctx).Where("id = ? AND status = ?", id, entity.CommentStatusAvailable).Get(&comment)
+	if err != nil || !exists {
+		return
+	}
+	var question entity.Question
+	exists, err = ns.data.DB.Context(ctx).Where("id = ? AND status IN (?, ?) AND `show` = ?", comment.QuestionID, entity.QuestionStatusAvailable, entity.QuestionStatusClosed, entity.QuestionShow).Get(&question)
+	if err != nil || !exists {
+		return
+	}
+	if comment.ObjectID != question.ID {
+		var answer entity.Answer
+		exists, err = ns.data.DB.Context(ctx).Where("id = ? AND question_id = ? AND status = ?", comment.ObjectID, question.ID, entity.AnswerStatusAvailable).Get(&answer)
+		if err != nil || !exists {
+			return
+		}
+	}
+	text := comment.ParsedText
+	if text == "" {
+		text = html.EscapeString(comment.OriginalText)
+	}
+	item.ObjectInfo.ObjectMap["comment_preview"] = commentPreview(text)
+}
