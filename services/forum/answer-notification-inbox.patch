+package notification
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"github.com/apache/answer/internal/base/data"
+	"github.com/apache/answer/internal/entity"
+	"github.com/apache/answer/internal/schema"
+	"testing"
+)
+
+func TestMetarInboxFiltersBeforePagination(t *testing.T) {
+	db, err := data.NewDB(false, &data.Database{Driver: "sqlite", Connection: ":memory:"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	if err = db.Sync2(new(entity.Notification)); err != nil {
+		t.Fatal(err)
+	}
+	actions := []string{"comment_question", "comment_answer", "reply_to_you", "mention_you", "up_voted_question", "up_voted_answer", "up_voted_comment", "down_voted_question", "answer_the_question"}
+	for i, action := range actions {
+		for _, user := range []string{"1", "2"} {
+			content, _ := json.Marshal(&schema.NotificationContent{NotificationAction: "notification.action." + action, ObjectInfo: schema.ObjectInfo{ObjectType: "comment"}})
+			row := &entity.Notification{ID: fmt.Sprint(i*2 + int(user[0]-'0')), UserID: user, Type: 1, MsgType: 1, Status: 1, Content: string(content)}
+			if _, err = db.Insert(row); err != nil {
+				t.Fatal(err)
+			}
+		}
+	}
+	repo := NewNotificationRepo(&data.Data{DB: db})
+	for filter, total := range map[string]int64{"answers": 1, "comments": 4, "likes": 3, "all": 9} {
+		seen := map[string]bool{}
+		for page := 1; page <= int(total); page++ {
+			rows, count, err := repo.GetNotificationPage(context.Background(), &schema.NotificationSearch{UserID: "1", Type: 1, InboxTypeStr: filter, Page: page, PageSize: 1})
+			if err != nil {
+				t.Fatal(err)
+			}
+			if count != total || len(rows) != 1 || rows[0].UserID != "1" || seen[rows[0].ID] {
+				t.Fatalf("%s page=%d count=%d rows=%v", filter, page, count, rows)
+			}
+			seen[rows[0].ID] = true
+		}
+	}
+}
