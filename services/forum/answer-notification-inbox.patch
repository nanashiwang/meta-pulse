+package notification
+
+import (
+	"context"
+	"github.com/apache/answer/internal/base/constant"
+	"github.com/apache/answer/internal/base/data"
+	"github.com/apache/answer/internal/entity"
+	"github.com/apache/answer/internal/schema"
+	"strings"
+	"testing"
+)
+
+func TestMetarCommentPreview(t *testing.T) {
+	cases := []struct{ input, want string }{
+		{"<p>具体步骤 <strong>有效</strong> &amp; 安全</p>", "具体步骤 有效 & 安全"},
+		{strings.Repeat("中", 25), strings.Repeat("中", 25)},
+		{strings.Repeat("中", 26), strings.Repeat("中", 25) + "…"},
+		{strings.Repeat("😀", 26), strings.Repeat("😀", 25) + "…"},
+		{"<script>alert(1)</script><p>正常</p>", "正常"},
+		{"  多行\n  空白  ", "多行 空白"},
+		{"", ""},
+	}
+	for _, c := range cases {
+		if got := commentPreview(c.input); got != c.want {
+			t.Errorf("preview(%q)=%q, want %q", c.input, got, c.want)
+		}
+	}
+}
+
+func TestMetarCommentPreviewVisibility(t *testing.T) {
+	db, err := data.NewDB(false, &data.Database{Driver: "sqlite", Connection: ":memory:"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	if err = db.Sync2(new(entity.Comment), new(entity.Question), new(entity.Answer)); err != nil {
+		t.Fatal(err)
+	}
+	q := &entity.Question{ID: "1", Status: 1, Show: 1}
+	a := &entity.Answer{ID: "2", QuestionID: "1", Status: 1, ParsedText: "<b>回答正文</b>"}
+	c := &entity.Comment{ID: "3", QuestionID: "1", ObjectID: "2", Status: 1, ParsedText: "<p>实际解决的方法</p>"}
+	for _, v := range []interface{}{q, a, c} {
+		if _, err = db.Insert(v); err != nil {
+			t.Fatal(err)
+		}
+	}
+	ns := &NotificationService{data: &data.Data{DB: db}}
+	check := func(want string) {
+		t.Helper()
+		item := &schema.NotificationContent{NotificationAction: constant.NotificationCommentAnswer, ObjectInfo: schema.ObjectInfo{ObjectType: "comment", ObjectMap: map[string]string{"comment": "3", "comment_preview": "stale"}}}
+		ns.addInboxPreview(context.Background(), item)
+		if got := item.ObjectInfo.ObjectMap["comment_preview"]; got != want {
+			t.Fatalf("got %q want %q", got, want)
+		}
+	}
+	checkAnswer := func(want string) {
+		t.Helper()
+		item := &schema.NotificationContent{NotificationAction: constant.NotificationAnswerTheQuestion, ObjectInfo: schema.ObjectInfo{ObjectType: "answer", ObjectID: "2", ObjectMap: map[string]string{"question": "1", "answer_preview": "stale"}}}
+		ns.addInboxPreview(context.Background(), item)
+		if got := item.ObjectInfo.ObjectMap["answer_preview"]; got != want {
+			t.Fatalf("answer preview: got %q want %q", got, want)
+		}
+	}
+	checkAnswer("回答正文")
+	check("实际解决的方法")
+	for _, status := range []int{10, 11} {
+		if _, err = db.Exec("UPDATE comment SET status=? WHERE id=3", status); err != nil {
+			t.Fatal(err)
+		}
+		check("")
+	}
+	db.Exec("UPDATE comment SET status=1 WHERE id=3")
+	db.Exec("UPDATE answer SET status=10 WHERE id=2")
+	checkAnswer("")
+	check("")
+	db.Exec("UPDATE answer SET status=1 WHERE id=2")
+	db.Exec("UPDATE question SET status=11 WHERE id=1")
+	check("")
+	db.Exec("UPDATE question SET status=2 WHERE id=1")
+	check("实际解决的方法")
+	db.Exec("UPDATE question SET " + "`show`" + "=2 WHERE id=1")
+	checkAnswer("")
+	check("")
+}
