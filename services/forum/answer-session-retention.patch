+
+// renewVisitCookie matches the renewed native bearer session; it never accepts
+// a user ID or token from a browser cookie as proof of authentication.
+func (am *AuthUserMiddleware) renewVisitCookie(ctx *gin.Context, info *entity.UserCacheInfo) {
+	if info.UserStatus != entity.UserStatusAvailable || info.VisitToken == "" {
+		return
+	}
+	general, err := am.siteInfoCommonService.GetSiteGeneral(ctx)
+	if err != nil {
+		return
+	}
+	site, err := url.Parse(general.SiteUrl)
+	if err != nil || site.Hostname() == "" {
+		return
+	}
+	ctx.SetCookie(constant.UserVisitCookiesCacheKey, info.VisitToken, constant.UserVisitCacheTime, "/", site.Hostname(), true, true)
+}
