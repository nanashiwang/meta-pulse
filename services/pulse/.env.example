# Meta Pulse
PULSE_ENV=development
PULSE_HTTP_ADDR=:8088

# Pulse MySQL
PULSE_DB_DSN=pulse:pulse_password@tcp(mysql:3306)/meta_pulse?charset=utf8mb4&parseTime=True&loc=Asia%2FShanghai

# Redis (runtime coordination only; never the ledger source of truth)
PULSE_REDIS_ADDR=redis:6379
PULSE_REDIS_PASSWORD=
PULSE_REDIS_DB=0

# new-api log database — MUST use a read-only database account
NEWAPI_LOG_DSN=readonly_user:readonly_password@tcp(newapi-mysql:3306)/new_api?charset=utf8mb4&parseTime=True&loc=Asia%2FShanghai

# Forum Answer database — read-only account, optional in local development.
# The worker disables only content ingestion when this is empty/unavailable.
FORUM_DB_DSN=readonly_user:readonly_password@tcp(forum-mysql:3306)/meta_pulse_forum?charset=utf8mb4&parseTime=True&loc=Asia%2FShanghai

# new-api internal Benefit API
NEWAPI_INTERNAL_BASE_URL=http://new-api:3000

# Service-to-service secrets
# Do not commit real values. Store production secrets in the server secret manager / password manager.
PULSE_SERVICE_HMAC_SECRET=replace-me
PULSE_USER_BFF_HMAC_SECRET=replace-me
PULSE_ADMIN_HMAC_SECRET=replace-me
# Dedicated HMAC secret for deterministic reward random; never reuse in production.
PULSE_REWARD_RANDOM_SECRET=replace-me
# Keep true until M5 external Benefit API and reconciliation are accepted.
PULSE_REWARD_SHADOW_MODE=true

# Worker
PULSE_INGEST_BATCH_SIZE=500
PULSE_SETTLEMENT_BATCH_SIZE=100
PULSE_PERIOD_CLOSE_BATCH_SIZE=20
PULSE_PERIOD_CLOSE_REQUIRE_WATERMARK=true
PULSE_PERIOD_REWARDS_ENABLED=false
PULSE_CONTENT_INGEST_BATCH_SIZE=100
PULSE_CONTENT_MIN_PAID_CONTRIBUTION_MILLI=1000
PULSE_CONTENT_MAX_USER_PERIOD_AMOUNT=100
PULSE_CONTENT_MAX_DAILY_AMOUNT=1000
PULSE_TICKET_THRESHOLD_MILLI=1000
