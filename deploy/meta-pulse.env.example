# Meta Pulse 生产部署配置
# 复制为仓库根目录 .env 后填写；install.sh 会为本地数据库和 HMAC 密钥自动生成随机值。
# .env 含有敏感信息，必须 chmod 600，严禁提交 Git。

COMPOSE_PROJECT_NAME=meta-pulse
PULSE_ENV=production
# API/Worker use separate persistent volumes for encrypted UI settings.
# Standard Compose sets PULSE_RUNTIME_KEY_DIR=/app/runtime-keys for each role.
# Keep the original env credentials as deployment fallback; UI overrides take precedence.

# Pulse 自有 MySQL（Compose 内部使用，不要复用 new-api 密码）
PULSE_DB_PASSWORD=replace-me
PULSE_DB_ROOT_PASSWORD=replace-me

# Forum 自有 MySQL（与 Pulse DB 隔离）。Compose 会仅向 forum 容器派生
# FORUM_BINDING_GUARD_DSN；该写连接不得注入 Pulse API/Worker。
FORUM_DB_PASSWORD=replace-me
FORUM_DB_ROOT_PASSWORD=replace-me

# Redis 仅用于缓存、Nonce、限流和短锁，不是事实源。
# 当前 Compose 的 Redis 未开启密码认证，保持为空；不要把它当作账本存储。
PULSE_REDIS_PASSWORD=
PULSE_REDIS_DB=0

# new-api LOG_DB：必须是只读账号；worker 启动时会执行权限检查。
NEWAPI_LOG_DSN=

# Answer 数据库只读 DSN，可选；为空时仅停用内容采集。
# 内容采集只认受保护的一对一绑定，且只采集绑定后公开内容。
FORUM_DB_DSN=

# new-api 内部 Benefit API。跨服务器时填写 WireGuard/私网地址，禁止裸露公网。
NEWAPI_INTERNAL_BASE_URL=http://new-api-private:3000


# 社区公网域名、Answer 插件和 Forum SSO 不由本 .env 自动配置：
#   Answer 开启本地注册/密码登录，new-api 绑定可选；
#   插件 sso_hmac_secret = new-api PULSE_FORUM_SSO_SECRET；
#   new-api PULSE_FORUM_SSO_CALLBACK_URL =
#     https://<新社区域名>/api/user-center/login/callback
# new-api 不部署在本服务器，也无需修改源码。

# 以下密钥必须与 new-api / 论坛插件的对应配置一致。
# install.sh 首次运行会自动生成至少 32 字节的随机值。
PULSE_SERVICE_HMAC_SECRET=replace-me
PULSE_SERVICE_HMAC_SECRET_PREVIOUS=
# 论坛只读 Profile 专用密钥；不得与结算/Worker 服务密钥复用。
PULSE_FORUM_HMAC_SECRET=replace-me
PULSE_FORUM_HMAC_SECRET_PREVIOUS=
PULSE_USER_BFF_HMAC_SECRET=replace-me
PULSE_USER_BFF_HMAC_SECRET_PREVIOUS=
PULSE_ADMIN_HMAC_SECRET=replace-me
PULSE_ADMIN_HMAC_SECRET_PREVIOUS=
PULSE_REWARD_RANDOM_SECRET=replace-me

# 外部 Benefit API、对账和回滚完成验收前必须保持 true。
PULSE_REWARD_SHADOW_MODE=true

# Worker 参数
# Worker 在 15s 后从已提交事件处让出批次，20s 为硬超时。
PULSE_INGEST_BATCH_SIZE=250
PULSE_SETTLEMENT_BATCH_SIZE=100
PULSE_PERIOD_CLOSE_BATCH_SIZE=20
PULSE_PERIOD_CLOSE_REQUIRE_WATERMARK=true
PULSE_PERIOD_REWARDS_ENABLED=false
PULSE_CONTENT_INGEST_BATCH_SIZE=100
PULSE_CONTENT_MIN_PAID_CONTRIBUTION_MILLI=1000
PULSE_CONTENT_MAX_USER_PERIOD_AMOUNT=100
PULSE_CONTENT_MAX_DAILY_AMOUNT=1000
PULSE_TICKET_THRESHOLD_MILLI=1000

# Community rewards are opt-in. Start a new verified-paid-v1 period with a frozen pool first.
PULSE_ACTIONS_ENABLED=false
# Must equal new-api's QuotaPerUnit (integer); zero leaves the entry disabled.
PULSE_QUOTA_PER_UNIT=0
# Optional until the community BFF is configured; never reuse profile/SSO/worker keys.
PULSE_COMMUNITY_BFF_HMAC_SECRET=
PULSE_COMMUNITY_BFF_HMAC_SECRET_PREVIOUS=
# Admin API only; this credential must NEVER be injected into pulse-worker.
PULSE_ROLLBACK_HMAC_SECRET=
PULSE_ROLLBACK_HMAC_SECRET_PREVIOUS=

# 基础设施独立选择；省略时均为 local，保持旧部署不变。
PULSE_DB_MODE=local
FORUM_DB_MODE=local
PULSE_REDIS_MODE=local
# external 模式需配置以下对应连接（不含引号，特殊 $ 用 $$ 遵循 Compose 规则）。
PULSE_DB_DSN=
FORUM_BINDING_GUARD_DSN=
PULSE_REDIS_ADDR=redis:6379
# URL 优先于旧的地址/密码/DB；rediss://acl-user:password@host:6380/0 开启 TLS。
PULSE_REDIS_URL=
PULSE_DB_MAX_OPEN_CONNS=20
PULSE_DB_MAX_IDLE_CONNS=10
PULSE_DB_CONN_MAX_LIFETIME=30m
PULSE_DB_CONN_MAX_IDLE_TIME=5m
# 数据库生产保持原 8.0；8.4 先在隔离恢复环境验证。
META_PULSE_MYSQL_IMAGE=mysql:8.0
META_PULSE_MYSQL_CLIENT_IMAGE=mysql:8.4
# 私有 CA 可设置 /etc/meta-pulse-ca/ca.pem；默认使用系统信任根。
SSL_CERT_FILE=
# 外部库必须显式提供备份账号，目标 host/port/schema 必须与应用一致。
PULSE_BACKUP_DB_DSN=
FORUM_BACKUP_DB_DSN=
