# Save outside Git with mode 600. Values are literal, not shell expressions.
# Install restic and initialize the encrypted repository deliberately first.
RESTIC_REPOSITORY=sftp:backup-host:/srv/backups/meta-pulse
RESTIC_PASSWORD_FILE=/etc/meta-pulse/restic-password
# Object storage credentials, if needed, may also be specified here.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
